---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Hygea – Limpieza y Mantenimiento",
  description = "Empresa de limpieza y mantenimiento para empresas, consorcios e instituciones. La Plata, Buenos Aires.",
} = Astro.props;
---
import "../styles/global.css";
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Sora (display) + DM Sans (body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  /* ─── Design tokens ─── */
  :root {
    /* Brand palette — extraída del CV */
    --c-blue-900: #003a7a;   /* azul marino oscuro */
    --c-blue-700: #005bb5;   /* azul principal */
    --c-blue-500: #1a7fd4;   /* azul medio (hover) */
    --c-blue-100: #dceeff;   /* azul muy claro (bg suave) */
    --c-white:    #ffffff;
    --c-off:      #f4f8fd;   /* fondo off-white con matiz azulado */
    --c-ink:      #0d1b2a;   /* casi negro */
    --c-muted:    #5b7089;   /* gris azulado */
    --c-accent:   #00c3ff;   /* celeste eléctrico — acento */

    /* Typography */
    --f-display: "Sora", sans-serif;
    --f-body:    "DM Sans", sans-serif;

    /* Spacing scale */
    --space-xs:  0.5rem;
    --space-sm:  1rem;
    --space-md:  2rem;
    --space-lg:  4rem;
    --space-xl:  7rem;

    /* Radius */
    --r-sm: 6px;
    --r-md: 14px;
    --r-lg: 28px;
    --r-pill: 999px;

    /* Shadow */
    --shadow-card: 0 4px 24px rgba(0, 91, 181, 0.10);
    --shadow-lg:   0 16px 48px rgba(0, 58, 122, 0.18);
  }

  /* ─── Reset & base ─── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--f-body);
    font-size: 1rem;
    line-height: 1.65;
    color: var(--c-ink);
    background: var(--c-white);
    -webkit-font-smoothing: antialiased;
  }

  img { max-width: 100%; display: block; }

  a { color: inherit; text-decoration: none; }

  h1, h2, h3, h4 {
    font-family: var(--f-display);
    line-height: 1.15;
    font-weight: 700;
  }

  /* ─── Utility classes ─── */
  .container {
    width: 100%;
    max-width: 1160px;
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  .section-label {
    display: inline-block;
    font-family: var(--f-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--c-blue-500);
    background: var(--c-blue-100);
    padding: 0.3em 0.85em;
    border-radius: var(--r-pill);
    margin-bottom: var(--space-sm);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.75em 1.6em;
    border-radius: var(--r-pill);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
    border: none;
  }

  .btn:hover  { transform: translateY(-2px); }
  .btn:active { transform: translateY(0); }

  .btn-primary {
    background: var(--c-blue-700);
    color: var(--c-white);
    box-shadow: 0 4px 18px rgba(0, 91, 181, 0.35);
  }
  .btn-primary:hover { background: var(--c-blue-500); box-shadow: var(--shadow-lg); }

  .btn-outline {
    background: transparent;
    color: var(--c-blue-700);
    border: 2px solid var(--c-blue-700);
  }
  .btn-outline:hover { background: var(--c-blue-100); }

  .btn-ghost-white {
    background: rgba(255,255,255,0.12);
    color: var(--c-white);
    border: 1.5px solid rgba(255,255,255,0.4);
    backdrop-filter: blur(6px);
  }
  .btn-ghost-white:hover { background: rgba(255,255,255,0.22); }

  /* ─── Animations ─── */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes shimmer {
    0%   { background-position: -200% center; }
    100% { background-position: 200% center; }
  }

  .anim-fade-up { animation: fadeUp 0.7s ease both; }
  .anim-delay-1 { animation-delay: 0.12s; }
  .anim-delay-2 { animation-delay: 0.24s; }
  .anim-delay-3 { animation-delay: 0.36s; }
  .anim-delay-4 { animation-delay: 0.48s; }
</style>
